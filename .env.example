# PC (exporter) — set with setx, not in a file:
#   setx GITHUB_TOKEN "github_pat_..."     (Contents: read & write on this repo)
#   setx GITHUB_REPO "your-username/madden-gm"
# Optional: MADDEN_SAVE_PATH, MADDEN_SAVES_DIR, MY_TEAM=CLE

# Render (server):
GITHUB_TOKEN=github_pat_...      # read-only is enough here
GITHUB_REPO=your-username/madden-gm
GITHUB_BRANCH=data
CAP_UNIT=10000
MCP_PATH=/mcp-REPLACE-WITH-A-RANDOM-GUID
